# ---- LLM settings ----
# Provider: "mock" | "openai_compatible" | "ollama" | "qwen" | "kimi" | "n1n"
LLM_PROVIDER=mock

# OpenAI-compatible (e.g., OpenAI / SiliconFlow / DeepSeek / etc.)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Qwen(DashScope) convenient config
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# Kimi (Moonshot, OpenAI-compatible)
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-k2-thinking

# N1N aggregator (OpenAI-compatible gateway)
N1N_BASE_URL=https://api.n1n.ai
N1N_API_KEY=
N1N_MODEL=gemini-3-pro

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ---- Data source settings ----
# Provider: "mock" | "akshare" | "tushare"
DATA_PROVIDER=mock
TUSHARE_TOKEN=

# ---- App settings ----
APP_NAME=AI Agent Portfolio Recommender
LOG_LEVEL=INFO
